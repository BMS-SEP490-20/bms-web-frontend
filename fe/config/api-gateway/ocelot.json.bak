        "UpstreamHttpMethod": [ "GET", "POST" ],
        "DownstreamScheme": "https",
        "DownstreamHostAndPorts": [
          {
            "Host": "localhost",
            "Port": 7105
          }
        ]
      },
      {
        "DownstreamPathTemplate": "/TestOrder/LabAssignment/{id}",
        "UpstreamPathTemplate": "/gateway/testorder/lab-assignments/{id}",
        "UpstreamHttpMethod": [ "GET", "PUT", "DELETE" ],
        "DownstreamScheme": "https",
        "DownstreamHostAndPorts": [
          {
            "Host": "localhost",
            "Port": 7105
          }
        ]
      },
      {
        "DownstreamPathTemplate": "/TestOrder/LabAssignment/bulk",
