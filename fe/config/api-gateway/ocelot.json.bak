          {
            "Host": "localhost",
            "Port": 5003
          }
        ]
      },
      {
        "DownstreamPathTemplate": "/TestOrder/DoctorRoom/{id}",
        "UpstreamPathTemplate": "/gateway/testorder/doctor-rooms/{id}",
        "UpstreamHttpMethod": [ "GET", "PUT", "DELETE" ],
        "DownstreamScheme": "http",
        "DownstreamHostAndPorts": [
          {
            "Host": "localhost",
            "Port": 5003
          }
        ]
      },

      {
        "DownstreamPathTemplate": "/TestOrder/LabAssignment",
