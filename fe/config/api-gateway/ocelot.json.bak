{
    "Routes": [
      {
        "DownstreamPathTemplate": "/IAM/auth/login",
        "UpstreamPathTemplate": "/gateway/iam/auth/login",
        "UpstreamHttpMethod": [ "POST" ],
        "DownstreamScheme": "https",
        "DownstreamHostAndPorts": [
          {
            "Host": "localhost",
            "Port": 7020
          }
        ],
        "TimeoutValue": 8000
      },
      
      /*-----------------------------------------
        NEW TestOrder Routes: Lab User Profile, Doctor Room, Lab Assignment, Lab Room
      -------------------------------------------*/
      {
        "DownstreamPathTemplate": "/TestOrder/LabUserProfile",
        "UpstreamPathTemplate": "/gateway/testorder/lab-user-profiles",
        "UpstreamHttpMethod": [ "GET" ],
        "DownstreamScheme": "http",
        "DownstreamHostAndPorts": [
          {
            "Host": "localhost",
            "Port": 5003
          }
        ]
      },
      {
        "DownstreamPathTemplate": "/TestOrder/LabUserProfile/{id}",
        "UpstreamPathTemplate": "/gateway/testorder/lab-user-profiles/{id}",
        "UpstreamHttpMethod": [ "GET", "PUT", "DELETE" ],
        "DownstreamScheme": "http",
        "DownstreamHostAndPorts": [
          {
            "Host": "localhost",
            "Port": 5003
          }
        ]
      },
      {
        "DownstreamPathTemplate": "/TestOrder/LabUserProfile/email/{email}",
